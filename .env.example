# Database connection (Neon PostgreSQL)
# Get this from Neon Console > Connection Details > Connection String
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=

# Analytics deployment environment (Cloudflare Workers / server)
# Allowed values: preview | production (default: preview)
APP_ENV=preview

# Public canonical origin for BOTH Production and Preview builds.
SITE_URL=https://lacadanang.quangdev.id.vn
# Optional Search Console HTML verification token supplied by Owner.
GOOGLE_SITE_VERIFICATION=
# Optional public GA4 Measurement ID; rebuild after changing.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
