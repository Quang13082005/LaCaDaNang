{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "la-ca-da-nang",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"vars": {
		"APP_ENV": "production"
	},
	"env": {
		"preview": {
			"name": "la-ca-da-nang-preview",
			"vars": {
				"APP_ENV": "preview"
			}
		},
		"production": {
			"vars": {
				"APP_ENV": "production"
			}
		}
	}
}
